{
  "manifest_version": 3,
  "name": "InstaCheers",
  "version": "1.3.2",
  "description": "Find Instagram accounts by keyword and follow them with random delays and resumable profile queues.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "InstaCheers"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.instagram.com/*",
        "https://instagram.com/*"
      ],
      "js": [
        "discovery.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
